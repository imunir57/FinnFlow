<?xml version="1.0" encoding="utf-8"?>
<!-- Backup / device-transfer config for API 31+. Mirrors backup_rules.xml: only the
     Room database and DataStore preferences carry over. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="money_manager.db" />
        <include domain="database" path="money_manager.db-wal" />
        <include domain="database" path="money_manager.db-shm" />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="money_manager.db" />
        <include domain="database" path="money_manager.db-wal" />
        <include domain="database" path="money_manager.db-shm" />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
